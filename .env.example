# Workspot definitions — JSON array.
# container=null (or omit) means run directly on the host machine.
# Use Discovery (the Discover button in the UI) to auto-detect workspots instead of defining them here.
WORKSPOTS=[{"name":"my-project","container":"devcontainer-app-1","dir":"/workspaces/my-project"},{"name":"local-bot","container":null,"dir":"/home/user/git/claude-bot"}]

# Port the launcher web UI will be served on
PORT=8765

# Seconds to wait for `claude remote-control` to output a session URL before timing out
URL_CAPTURE_TIMEOUT=30

# Flags passed to the `claude` binary before the subcommand (e.g. --plugin-dir ...)
CLAUDE_GLOBAL_FLAGS=

# Flags passed to `remote-control` (e.g. --permission-mode bypassPermissions)
CLAUDE_RC_FLAGS=

# Comma-separated directories to scan when using auto-discovery (~ is expanded)
DISCOVERY_SCAN_DIRS=~/git/

# Tailscale auth key (generate at https://login.tailscale.com/admin/settings/keys)
TAILSCALE_AUTHKEY=

# Hostname that appears in your Tailscale admin panel
TAILSCALE_HOSTNAME=csl

# ISO date your Tailscale auth key expires — used for expiry warnings in logs
TS_KEY_EXPIRES=2026-12-31

# --- Native install: override these so data is stored locally rather than /data/ ---
# SESSION_REGISTRY_FILE=./data/session-registry.json
# SESSION_HISTORY_FILE=./data/sessions.json
# WORKSPOT_CONFIG_FILE=./data/workspots.json
